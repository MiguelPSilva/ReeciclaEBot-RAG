# Copie este arquivo para ".env" (sem o .example) quando rodar localmente.
# Nunca faça commit do seu arquivo .env real!

# Token de acesso da Hugging Face (opcional: se vazio, o bot usa o modo fallback)
# Crie um token gratuito (tipo Read) em: https://huggingface.co/settings/tokens
HF_TOKEN=seu_token_aqui

# Modelo de chat usado na API da Hugging Face (opcional)
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
